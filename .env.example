# Copy these values into the hosting platform's encrypted environment-variable UI.
# Do not commit a real .env file and do not place any value below in browser code.
# APP_MODE=demo
MIAOSHOU_BASE_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_APP_KEY=your_miaoshou_app_key
MIAOSHOU_APP_SECRET=your_miaoshou_app_secret
# Optional overrides for read-only order/parcel synchronization. The defaults
# already use MiaoShou "包裹-包裹-批量获取包裹列表" with page/pageSize.
# No order, shipping, tracking, or after-sales data is ever written back.
MIAOSHOU_PACKAGE_LIST_PATH=/open/v1/order/package/fetch/search_package_list
MIAOSHOU_PACKAGE_LIST_PAYLOAD={"page":1,"pageSize":100}
# Optional independent account slots. Slot 2 is shown by default; define
# MIAOSHOU_ACCOUNT_3_* (through _20_*) later to add more navigation entries.
# These values remain server-side. A dedicated per-account workflow is needed
# before any non-primary slot makes MiaoShou API calls.
MIAOSHOU_ACCOUNT_2_NAME=妙手采集箱 2
MIAOSHOU_ACCOUNT_2_APP_KEY=
MIAOSHOU_ACCOUNT_2_APP_SECRET=
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
# Optional: enables AI product-image editing. Keep this server-side only.
OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Optional: local Qwen-Image-Edit via ComfyUI. This must remain a loopback URL.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_QWEN_UNET=qwen_image_2.1_int8_convrot.safetensors
COMFYUI_QWEN_CLIP=qwen3vl_8b_int8_convrot.safetensors
COMFYUI_QWEN_VAE=qwen_image_2.1_vae_bf16.safetensors
# Keep the service private until a deployment and IP allowlist are configured.
HOST=127.0.0.1
PORT=8787
