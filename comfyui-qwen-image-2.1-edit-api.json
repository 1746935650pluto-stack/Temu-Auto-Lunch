  "5": {"class_type": "TextEncodeQwenImage21", "inputs": {"clip": ["3", 0], "vae": ["4", 0], "prompt": "使用 <image1> 作为需要编辑的电商商品原图。保留商品主体、颜色、比例和细节；不要添加文字、水印或无关商品。修改要求：替换为干净纯白背景。", "negative_prompt": "", "resolution": 0, "images": {"image_1": ["1", 0]}}},
